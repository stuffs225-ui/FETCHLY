PORT=4000
# Public address of the site (used only to print the two private links at startup).
BASE_URL=https://example.com
# Optional — fixed link tokens (otherwise generated once and stored). Print them with: npm run links
LINK_TOKEN_A=
LINK_TOKEN_B=
# Optional — signing key for the login cookie (auto-generated and stored if omitted).
SESSION_SECRET=
# Where the database and voice notes live (default: server/data).
DATA_DIR=

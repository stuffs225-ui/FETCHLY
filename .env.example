# Copy this file to .env and fill in real values before running the server.

# --- Server ---
PORT=4000
NODE_ENV=development
# Origin of the frontend (Vite dev server, or your deployed site URL) — required for CORS + cookies.
FRONTEND_URL=http://localhost:5173

# --- Sessions ---
# A long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production; the server refuses to start without it.
SESSION_SECRET=

# --- First admin account bootstrap ---
# Only used once, the first time the server starts with an empty adminUsers table.
# After the account exists, log in and manage further admin users from Admin → Users.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Transactional email (SMTP) ---
# Use your business email provider's SMTP credentials (Microsoft 365, Google Workspace,
# or any SMTP relay). Without these, request/quotation emails will fail to send and the
# failure will be recorded honestly in the Email Log — nothing is simulated.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

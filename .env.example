# Everything here is OPTIONAL. On Vercel, connecting a Neon database sets DATABASE_URL for you.
# Without DATABASE_URL, local development uses an embedded Postgres in server/data/pg.
DATABASE_URL=
PORT=4000
# Only if you want fixed link tokens / a fixed cookie key instead of auto-generated ones.
LINK_TOKEN_A=
LINK_TOKEN_B=
SESSION_SECRET=

# The secret phrase only the two of you know (required in production).
ROOM_PASSPHRASE=
PORT=4000
# Optional — a signing key for the login cookie (auto-generated and stored if omitted).
SESSION_SECRET=
# Grammatical gender used for Arabic wording: slot A defaults to m (him), slot B to f (her).
GENDER_A=m
GENDER_B=f
# Where the database and voice notes live (default: server/data).
DATA_DIR=
# Contact for web-push (any mailto: or https: URL).
VAPID_SUBJECT=mailto:you@example.com
